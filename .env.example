# Second Brain - Environment Configuration

# =============================================================================
# Required
# =============================================================================

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://localhost:5432/second_brain

# OpenAI API Key (used for both LLM and embeddings)
OPENAI_API_KEY=your-openai-key-here

# Optional: Override LLM model (default: gpt-5-mini)
# SECOND_BRAIN_LLM_MODEL=gpt-5-mini

# =============================================================================
# Optional - API Server
# =============================================================================

PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# NODE_ENV=development

# CORS origin for web UI
CORS_ORIGIN=http://localhost:5173

# API authentication token (recommended for production)
# API_AUTH_TOKEN=your-secret-token-here

# =============================================================================
# Optional - Web Frontend (Vite uses VITE_ prefix)
# =============================================================================

VITE_API_URL=http://localhost:3001
