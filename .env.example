# Second Brain - Environment Configuration

# =============================================================================
# Required
# =============================================================================

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://localhost:5432/second_brain

# OpenAI API Key (used for both LLM and embeddings)
OPENAI_API_KEY=your-openai-key-here

# Optional: Anthropic key
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional: Gemini direct API key
# GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key-here

# Optional: Provider override (openai | anthropic | google | vertex)
# SECOND_BRAIN_LLM_PROVIDER=openai

# Optional: Override LLM model (default: gpt-5-mini)
# SECOND_BRAIN_LLM_MODEL=gpt-5-mini

# Optional: Dedicated fast UI model (used by AG-UI and CopilotKit runtime)
# SECOND_BRAIN_UI_MODEL=gemini-3-flash-preview

# Optional: Vertex AI (used when SECOND_BRAIN_LLM_PROVIDER=vertex)
# GOOGLE_VERTEX_PROJECT=your-gcp-project-id
# GOOGLE_VERTEX_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_VERTEX_CREDENTIALS_JSON={"type":"service_account",...}

# =============================================================================
# Optional - API Server
# =============================================================================

PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# NODE_ENV=development

# CORS origin for web UI
CORS_ORIGIN=http://localhost:5173

# API authentication token (recommended for production)
# API_AUTH_TOKEN=your-secret-token-here

# =============================================================================
# Optional - Web Frontend (Vite uses VITE_ prefix)
# =============================================================================

VITE_API_URL=http://localhost:3001
